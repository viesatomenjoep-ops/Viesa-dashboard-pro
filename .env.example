# ==============================================================================
# Viesa Dashboard Pro — omgevingsvariabelen
# ------------------------------------------------------------------------------
# Kopieer dit bestand naar `.env.local` en vul de echte waarden in.
# `.env.local` staat in .gitignore en mag NOOIT gecommit worden.
# ==============================================================================

# --- Supabase project ---------------------------------------------------------
# Te vinden in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publieke sleutel voor de browser (anon / publishable).
# Alleen deze sleutel mag in de client terechtkomen.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-public-key>

# Optioneel: nieuwe Supabase "publishable" sleutel (sb_publishable_...)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>

# --- Supabase server-only geheimen --------------------------------------------
# NOOIT met NEXT_PUBLIC_ prefix; alleen server-side gebruiken.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Optioneel: nieuwe Supabase "secret" sleutel (sb_secret_...)
# SUPABASE_SECRET_KEY=<supabase-secret-key>

# --- App ----------------------------------------------------------------------
# Basis-URL van de app (lokaal of productie op Vercel).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Leads-ingest (webshop-prospector) ----------------------------------------
# Jouw auth-uuid (Supabase > Authentication > Users > jouw gebruiker > User UID).
# De ingest zet dit als owner_id omdat de service-role sleutel geen auth.uid() heeft.
OWNER_USER_ID=<jouw-auth-user-uuid>

# Gedeeld geheim dat de prospector meestuurt in de header x-viesa-ingest-secret.
LEADS_INGEST_SECRET=<genereer-een-lang-willekeurig-geheim>

# --- Apify (Google Maps-prospector op de leads-pagina) -------------------------
# API-token uit Apify > Settings > Integrations. Server-only, nooit NEXT_PUBLIC_.
APIFY_TOKEN=<apify-api-token>

# --- Google Places (goedkoper alternatief voor Apify, zelfde prospector) -------
# Google Cloud Console (mag hetzelfde project zijn als PAGESPEED_API_KEY) →
# APIs & Services → Library → "Places API (New)" → Enable → Credentials → API
# key. Beperk de sleutel bij voorkeur tot deze API. Geeft geen e-mail/LinkedIn
# terug (dat blijft voorbehouden aan de Apify-add-on).
GOOGLE_PLACES_API_KEY=<google-api-key>

# --- Cron (Vercel) ------------------------------------------------------------
# Beveiligt de dagelijkse crons (facturen-bewaking + dagelijkse update-mail).
CRON_SECRET=<genereer-een-lang-willekeurig-geheim>
# Ontvangers van de dagelijkse update-mail (komma-gescheiden). Standaard gaan
# ze naar tomvanbien@gmail.com en contact@viesa-automations.nl.
DAGUPDATE_ONTVANGERS=tomvanbien@gmail.com,contact@viesa-automations.nl

# --- Brand Factory sync -------------------------------------------------------
# Gedeeld geheim voor POST /api/brand-factory/sync (server-to-server vanaf de
# lokale Brand Factory op de Mac). Server-only, nooit NEXT_PUBLIC_.
BRAND_FACTORY_SECRET=<genereer-een-lang-willekeurig-geheim>

# --- Design-editor GitHub-sync ------------------------------------------------
# PAT met 'contents: read and write' op de repo. Los van je sessie-token.
GITHUB_TOKEN=<github-pat-met-contents-write>
GITHUB_REPO=viesatomenjoep-ops/Viesa-dashboard-pro
GITHUB_BRANCH=main

# --- Claude API (offerte-generator) -------------------------------------------
ANTHROPIC_API_KEY=<claude-api-key>
# Optioneel: model overschrijven (standaard claude-sonnet-5)
# CLAUDE_MODEL=claude-sonnet-5

# --- Google / Gmail (koppeling) -----------------------------------------------
# OAuth-client uit Google Cloud Console. Redirect-URI moet exact matchen.
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_REDIRECT_URI=https://<jouw-domein>/api/google/oauth/callback
# Optioneel: Drive-map-id waar gescande bonnetjes/facturen in terechtkomen.
# Leeg = in de hoofdmap van de verbonden Drive. Het id staat in de map-URL.
GOOGLE_DRIVE_FOLDER_ID=

# --- Microsoft / Outlook (Graph, gedelegeerd) ---------------------------------
# App-registratie in Entra (Azure AD). Redirect-URI moet exact matchen.
MS_CLIENT_ID=<microsoft-app-client-id>
MS_TENANT_ID=<microsoft-tenant-id-of-common>
MS_CLIENT_SECRET=<microsoft-client-secret>
MS_REDIRECT_URI=https://<jouw-domein>/api/auth/microsoft/callback
# 32-byte sleutel (base64 of hex) voor het versleutelen van de MSAL-tokencache.
# Genereer bijv. met: openssl rand -base64 32
MS_TOKEN_ENC_KEY=<32-byte-base64-of-hex-sleutel>

# --- Resend (e-mail versturen/ontvangen) --------------------------------------
# API-key uit het Resend-dashboard. Server-only, nooit met NEXT_PUBLIC-prefix.
# Verifieer het domein viesa-automations.nl in Resend om vanaf contact@... te sturen.
RESEND_API_KEY=<resend-api-key>
# Ontvangen: Svix signing secret van de inbound-webhook (whsec_...). Aanbevolen.
# Uit Resend → Webhooks → jouw webhook (event 'email.received'). Server-only.
RESEND_INBOUND_SIGNING_SECRET=<whsec_...>
# Alternatief/legacy: gedeeld geheim voor handmatig testen van /api/resend/inbound
# via ?secret=... of header x-webhook-secret (gebruik liever de signing secret).
RESEND_INBOUND_SECRET=<lang-geheim>

# --- Fonio (AI-telefonie, resellerprogramma) ----------------------------------
# Alleen nodig zodra de democonsole meer doet dan bellen/linken — bijvoorbeeld
# het via de partner-API aanmaken van een demo-agent per prospect.
# Server-only, nooit met NEXT_PUBLIC-prefix.
# Het demonummer, de demo-link en het partnerportaal stel je niet hier in maar
# in het dashboard onder Koppelingen → Fonio-demo.
FONIO_API_KEY=<fonio-partner-api-key>

# --- AI Visibility Audit ------------------------------------------------------
# De vier modellen die bevraagd worden. Alle vier server-only; nooit met een
# NEXT_PUBLIC_-prefix. Een ontbrekende sleutel laat alleen dát model uitvallen —
# de audit toont de andere drie gewoon.
OPENAI_API_KEY=<sk-...>
# Alleen nodig als je OpenAI-account bij meerdere organisaties hoort. Dit is
# geen geheim maar een identificatie (org-...); zonder deze regel gebruikt
# OpenAI je standaardorganisatie.
OPENAI_ORG_ID=<org-...>
# Uit Google AI Studio (aistudio.google.com → Get API key), NIET uit de Cloud
# Console — daar krijg je een Vertex-sleutel die niet werkt met deze SDK.
# AI Studio geeft tegenwoordig sleutels die met `AQ.` beginnen; de oudere
# `AIza...`-vorm bestaat ook nog. Allebei goed.
GEMINI_API_KEY=<AQ.… of AIza…>
PERPLEXITY_API_KEY=<perplexity-api-key>
# ANTHROPIC_API_KEY staat al hierboven en wordt hergebruikt.
#
# Optioneel: overschrijf het model zonder te hoeven deployen.
# OPENAI_MODEL=gpt-4o
# CLAUDE_MODEL=claude-opus-5
# GEMINI_MODEL=gemini-2.0-flash
# PERPLEXITY_MODEL=sonar

# Website/app-prototype (AI-knop naast het gratis sjabloon) — staat los van
# CLAUDE_MODEL, standaard al op het goedkopere claude-sonnet-5.
# PROTOTYPE_MODEL=claude-sonnet-5

# --- Google PageSpeed Insights (websitescanner) --------------------------------
# Gratis, 25.000 aanvragen per dag, geen betaalprofiel nodig. Uit de Google Cloud
# Console (zelfde project als de OAuth-client hierboven): APIs & Services →
# Library → "PageSpeed Insights API" → Enable → Credentials → API key.
# Beperk de sleutel daarna tot alleen deze API.
# Zonder deze sleutel werkt de scanner ook, maar met een veel lagere limiet.
PAGESPEED_API_KEY=<google-api-key>
