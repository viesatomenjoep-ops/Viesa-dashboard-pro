# ==============================================================================
# Viesa Dashboard Pro — omgevingsvariabelen
# ------------------------------------------------------------------------------
# Kopieer dit bestand naar `.env.local` en vul de echte waarden in.
# `.env.local` staat in .gitignore en mag NOOIT gecommit worden.
# ==============================================================================

# --- Supabase project ---------------------------------------------------------
# Te vinden in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publieke sleutel voor de browser (anon / publishable).
# Alleen deze sleutel mag in de client terechtkomen.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-public-key>

# Optioneel: nieuwe Supabase "publishable" sleutel (sb_publishable_...)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>

# --- Supabase server-only geheimen --------------------------------------------
# NOOIT met NEXT_PUBLIC_ prefix; alleen server-side gebruiken.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Optioneel: nieuwe Supabase "secret" sleutel (sb_secret_...)
# SUPABASE_SECRET_KEY=<supabase-secret-key>

# --- App ----------------------------------------------------------------------
# Basis-URL van de app (lokaal of productie op Vercel).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Leads-ingest (webshop-prospector) ----------------------------------------
# Jouw auth-uuid (Supabase > Authentication > Users > jouw gebruiker > User UID).
# De ingest zet dit als owner_id omdat de service-role sleutel geen auth.uid() heeft.
OWNER_USER_ID=<jouw-auth-user-uuid>

# Gedeeld geheim dat de prospector meestuurt in de header x-viesa-ingest-secret.
LEADS_INGEST_SECRET=<genereer-een-lang-willekeurig-geheim>

# --- Cron (Vercel) ------------------------------------------------------------
# Beveiligt de dagelijkse cron die facturen op 'te_laat' zet.
CRON_SECRET=<genereer-een-lang-willekeurig-geheim>

# --- Design-editor GitHub-sync ------------------------------------------------
# PAT met 'contents: read and write' op de repo. Los van je sessie-token.
GITHUB_TOKEN=<github-pat-met-contents-write>
GITHUB_REPO=viesatomenjoep-ops/Viesa-dashboard-pro
GITHUB_BRANCH=main
