      "rol": "Koppen en lopende tekst"
    },
    "data": {
      "familie": "IBM Plex Mono",
      "terugval": "ui-monospace, SFMono-Regular, monospace",
      "gewichten": [400, 500, 600],
      "rol": "Bovenkopjes in kapitalen, meetwaarden, alles wat in kolommen uitlijnt"
    }
  },

  "maat": {
    "radius-klein": "12px",
    "radius-kaart": "20px",
    "radius-blok":  "24px",
    "radius-pil":   "999px",
    "letterafstand-label": "0.16em",
    "letterafstand-kop": "-0.022em",
    "leesbreedte": "68ch"
