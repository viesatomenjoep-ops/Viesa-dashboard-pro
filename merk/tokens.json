    "terracotta":{ "waarde": "#E2603F", "rol": "Het enige accent. Betekent 'Viesa', nooit 'fout'" },
    "zand":      { "waarde": "#F3F0E9", "rol": "Paginabachtergrond" },
    "zanddiep":  { "waarde": "#EEEBE2", "rol": "Ingezonken vlak — tabelkop, uitklapblok" },
    "wit":       { "waarde": "#FFFFFF", "rol": "Kaarten" },
    "tekst":     { "waarde": "#1B2434", "rol": "Lopende tekst" },
    "gedempt":   { "waarde": "#55617A", "rol": "Bijschrift, uitleg" },
    "zacht":     { "waarde": "#8A8FA0", "rol": "Labels, asaanduidingen" },
    "lijn":      { "waarde": "#E4E1D8", "rol": "Haarlijn — geen zebra, alleen scheiding" }
  },

  "signaal": {
    "goed":  { "waarde": "#2E7355", "vlak": "#E7F0EA", "label": "Goed" },
    "beter": { "waarde": "#B87322", "vlak": "#F8EEDF", "label": "Kan beter" },
