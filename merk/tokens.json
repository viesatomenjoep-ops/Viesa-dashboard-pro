{
  "$naam": "Viesa Automations — merkpakket",
  "$versie": "1.0.0",
  "$toelichting": "Eén bron voor de huisstijl. Gelezen door het klantrapport (app/rapport), en bedoeld om ook door de Brand Factory op de Mac ingelezen te worden. Wijzig kleuren hier, niet in componenten.",

  "kleur": {
    "navy":      { "waarde": "#19445B", "rol": "Primaire merkkleur — koppen, knoppen, randen" },
